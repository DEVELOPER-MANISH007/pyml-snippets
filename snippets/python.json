        ")",
        "",
        "# Vocabulary",
        "print(model.wv.key_to_index)",
        "",
        "# Get word vector",
        "word_vector = model.wv['${1:good}']",
        "print(word_vector)",
        "",
        "# Find similar words",
        "similar_words = model.wv.most_similar('${2:good}', topn=10)",
        "print(similar_words)",
        "",
        "# Check similarity between two words",
        "similarity = model.wv.similarity('${3:good}', '${4:great}')",
